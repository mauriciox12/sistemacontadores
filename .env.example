# ====================================================================
# KONTIFY APP — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copia este archivo como .env y coloca tus credenciales reales
# ====================================================================

# 1. ENTORNO DE LA APLICACIÓN
APP_NAME="Kontify APP"
APP_ENV=local                  # local | production
APP_DEBUG=true                 # true | false
APP_URL=http://localhost/Kontifyapp

# 2. CONEXIÓN A LA BASE DE DATOS PRINCIPAL (MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kontify_db
DB_USERNAME=root
DB_PASSWORD=

# 3. BASE DE DATOS DE CONTINGENCIA / LOCAL (SQLite)
# En caso de no poder conectar a MySQL en local, usa kontify_local.sqlite
SQLITE_PATH="kontify_local.sqlite"

# 4. CONFIGURACIÓN FISCAL Y CAMBIARIA (VENEZUELA)
DEFAULT_TASA_BCV=65.50
CURRENCY_CODE="USD"
SECONDARY_CURRENCY_CODE="VES"

# 5. SEGURIDAD Y SESIÓN
SESSION_LIFETIME=120
SESSION_NAME=kontify_session_id
APP_SECRET=generate_a_random_32_characters_key_here

# ====================================================================
# EJEMPLO PARA SERVIDOR DE PRODUCCIÓN (cPanel / Namecheap):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://nexusgestions.online/Kontifyapp
# DB_HOST=localhost
